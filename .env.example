# ==========================================
# AutoCash AI / Nexus Terminal - Environment Configuration
# ==========================================

# 1. Google Gemini AI API Key (Required for AI digital product & viral script generation)
# Handled securely server-side; NEVER exposed to browser code.
GEMINI_API_KEY=""

# 2. Whop Developer Platform Credentials (Required for production launch on Whop)
# Obtain these from your Whop Developer Dashboard (dash.whop.com -> Settings -> Developer)
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
WHOP_APP_ID=""
WHOP_COMPANY_ID=""

# 3. Persistent Database Connection
# REQUIRED IN PRODUCTION: PostgreSQL / Cloud SQL / Supabase connection string.
# (e.g. postgresql://user:password@host:5432/autocash_db?sslmode=require)
# Note: The server fails fast on startup in production if DATABASE_URL is missing to prevent ephemeral data loss.
# In local development only (NODE_ENV !== 'production'), falls back to /data/store.json.
DATABASE_URL=""

# 4. Whop Live Checkout Links (Must be verified https://whop.com/checkout/... URLs)
# Create the three real offers in dash.whop.com -> Products -> Checkout Links:
#   Starter $9.99/month, Pro $29.99/month, Lifetime Founders $99.99 one-time
WHOP_STARTER_CHECKOUT_URL=""
WHOP_PRO_CHECKOUT_URL=""
WHOP_FOUNDERS_CHECKOUT_URL=""
# Deprecated fallbacks (pre-rename names, still read if the new ones are unset):
# WHOP_EMPIRE_CHECKOUT_URL is honoured as the Founders checkout URL.

# 5. Plan Quotas & Economics (Optional overrides)
# Credit allowances per period: Free trial 5, Starter 25, Pro 100, Lifetime Founders 500.
# Default Founders quota is 500 generation credits per period.
FOUNDERS_TIER_CREDITS=500
# Deprecated fallback: EMPIRE_TIER_CREDITS is honoured if FOUNDERS_TIER_CREDITS is unset.

# 6. Public Application URL
# Used for constructing absolute webhook and deliverable URLs (e.g. https://your-app.run.app)
APP_URL=""

# 7. Server Runtime Configuration
PORT=3000
NODE_ENV="development"
